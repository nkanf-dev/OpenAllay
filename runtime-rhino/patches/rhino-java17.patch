+package dev.latvian.mods.rhino.util;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.Deque;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.List;
+import java.util.NoSuchElementException;
+
+/** Java 8 equivalents of sequenced List operations and immutable collection factories. */
+public final class ListCompat {
+	private ListCompat() {
+	}
+
+	@SuppressWarnings("unchecked")
+	public static <E> E getFirst(List<E> list) {
+		if (list instanceof Deque<?>) {
+			return ((Deque<E>) list).getFirst();
+		}
+		if (list.isEmpty()) {
+			throw new NoSuchElementException();
+		}
+		return list.get(0);
+	}
+
+	@SuppressWarnings("unchecked")
+	public static <E> E getLast(List<E> list) {
+		if (list instanceof Deque<?>) {
+			return ((Deque<E>) list).getLast();
+		}
+		int size = list.size();
+		if (size == 0) {
+			throw new NoSuchElementException();
+		}
+		return list.get(size - 1);
+	}
+
+	@SuppressWarnings("unchecked")
+	public static <E> E removeFirst(List<E> list) {
+		if (list instanceof Deque<?>) {
+			return ((Deque<E>) list).removeFirst();
+		}
+		if (list.isEmpty()) {
+			throw new NoSuchElementException();
+		}
+		return list.remove(0);
+	}
+
+	@SuppressWarnings("unchecked")
+	public static <E> E removeLast(List<E> list) {
+		if (list instanceof Deque<?>) {
+			return ((Deque<E>) list).removeLast();
+		}
+		int size = list.size();
+		if (size == 0) {
+			throw new NoSuchElementException();
+		}
+		return list.remove(size - 1);
+	}
+
+	@SuppressWarnings("unchecked")
+	public static <E> void addFirst(List<E> list, E value) {
+		if (list instanceof Deque<?>) {
+			((Deque<E>) list).addFirst(value);
+		} else {
+			list.add(0, value);
+		}
+	}
+
+	@SafeVarargs
+	public static <E> List<E> listOf(E... elements) {
+		return copyList(Arrays.asList(elements));
+	}
+
+	public static <E> List<E> copyList(Collection<? extends E> elements) {
+		List<E> copy = new ArrayList<E>(elements.size());
+		for (E element : elements) {
+			copy.add(Objects.requireNonNull(element));
+		}
+		return Collections.unmodifiableList(copy);
+	}
+
+	@SafeVarargs
+	public static <E> Set<E> setOf(E... elements) {
+		Set<E> copy = new LinkedHashSet<E>();
+		for (E element : elements) {
+			if (!copy.add(Objects.requireNonNull(element))) {
+				throw new IllegalArgumentException("duplicate element: " + element);
+			}
+		}
+		return Collections.unmodifiableSet(copy);
+	}
+
+	public static <E> Set<E> copySet(Collection<? extends E> elements) {
+		Set<E> copy = new LinkedHashSet<E>();
+		for (E element : elements) {
+			copy.add(Objects.requireNonNull(element));
+		}
+		return Collections.unmodifiableSet(copy);
+	}
+
+	public static <K, V> Map<K, V> copyMap(Map<? extends K, ? extends V> entries) {
+		Map<K, V> copy = new LinkedHashMap<K, V>();
+		for (Map.Entry<? extends K, ? extends V> entry : entries.entrySet()) {
+			K key = Objects.requireNonNull(entry.getKey());
+			V value = Objects.requireNonNull(entry.getValue());
+			if (copy.containsKey(key)) {
+				throw new IllegalArgumentException("duplicate key: " + key);
+			}
+			copy.put(key, value);
+		}
+		return Collections.unmodifiableMap(copy);
+	}
+
+	public static String repeat(String value, int count) {
+		Objects.requireNonNull(value);
+		if (count < 0) {
+			throw new IllegalArgumentException("count is negative: " + count);
+		}
+		if (count == 0 || value.isEmpty()) {
+			return "";
+		}
+		long length = (long) value.length() * count;
+		if (length > Integer.MAX_VALUE) {
+			throw new OutOfMemoryError("Required string length exceeds implementation limit");
+		}
+		StringBuilder result = new StringBuilder((int) length);
+		for (int i = 0; i < count; i++) {
+			result.append(value);
+		}
+		return result.toString();
+	}
