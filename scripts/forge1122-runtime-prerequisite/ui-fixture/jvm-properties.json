{
  "openallay.e2e.enabled": "true",
  "openallay.e2e.scenario": "ui-manual-regressions",
  "openallay.e2e.session": "forge112-ui",
  "openallay.e2e.question": "OpenAllay E2E UI manual regressions",
  "openallay.e2e.modelMode": "client",
  "openallay.e2e.createWorld": "openallay-builder-forge112-ui",
  "openallay.e2e.report": "${EVIDENCE}/ui-manual-report.json",
  "openallay.e2e.trace": "${EVIDENCE}/ui-manual-trace.json",
  "openallay.e2e.screenshotRoot": "${EVIDENCE}/frames",
  "openallay.e2e.timeoutSeconds": "600",
  "openallay.e2e.shutdown": "true",
  "openallay.e2e.shutdownAfterScreenshots": "true",
  "openallay.e2e.sourceRevision": "${EXACT_PRODUCT_SOURCE_REVISION}",
  "openallay.e2e.sourceManifestSha256": "${EXACT_PRODUCT_SOURCE_MANIFEST_SHA256}"
}
