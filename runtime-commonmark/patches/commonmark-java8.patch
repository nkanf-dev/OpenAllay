+package org.commonmark.internal.util;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+
+/** Java 8 equivalents of the immutable factory calls used by upstream sources. */
+public final class Java8Collections {
+    private Java8Collections() { }
+
+    @SafeVarargs
+    public static <E> List<E> listOf(E... elements) {
+        Objects.requireNonNull(elements, "elements");
+        List<E> values = new NullRejectList<>();
+        for (E element : elements) {
+            values.add(Objects.requireNonNull(element, "element"));
+        }
+        return Collections.unmodifiableList(values);
+    }
+
+    @SafeVarargs
+    public static <E> Set<E> setOf(E... elements) {
+        Objects.requireNonNull(elements, "elements");
+        Set<E> values = new NullRejectSet<>();
+        for (E element : elements) {
+            if (!values.add(Objects.requireNonNull(element, "element"))) {
+                throw new IllegalArgumentException("duplicate element: " + element);
+            }
+        }
+        return Collections.unmodifiableSet(values);
+    }
+
+    public static <K, V> Map<K, V> mapOf() {
+        return Collections.unmodifiableMap(new NullRejectMap<K, V>());
+    }
+
+    public static <K, V> Map<K, V> mapOf(K key, V value) {
+        Map<K, V> values = new NullRejectMap<>();
+        values.put(Objects.requireNonNull(key, "key"), Objects.requireNonNull(value, "value"));
+        return Collections.unmodifiableMap(values);
+    }
+
+    // Preserve the null-query rejection of JDK immutable factory collections.
+    // Unmodifiable wrappers reject every mutation, including empty/no-op changes.
+    private static final class NullRejectList<E> extends ArrayList<E> {
+        NullRejectList() { }
+        @Override public boolean contains(Object value) {
+            return super.contains(Objects.requireNonNull(value, "value"));
+        }
+        @Override public int indexOf(Object value) {
+            return super.indexOf(Objects.requireNonNull(value, "value"));
+        }
+        @Override public int lastIndexOf(Object value) {
+            return super.lastIndexOf(Objects.requireNonNull(value, "value"));
+        }
+    }
+    private static final class NullRejectSet<E> extends LinkedHashSet<E> {
+        NullRejectSet() { }
+        @Override public boolean contains(Object value) {
+            return super.contains(Objects.requireNonNull(value, "value"));
+        }
+    }
+    private static final class NullRejectMap<K, V> extends HashMap<K, V> {
+        NullRejectMap() { }
+        @Override public V get(Object key) {
+            return super.get(Objects.requireNonNull(key, "key"));
+        }
+        @Override public boolean containsKey(Object key) {
+            return super.containsKey(Objects.requireNonNull(key, "key"));
+        }
+        @Override public boolean containsValue(Object value) {
+            return super.containsValue(Objects.requireNonNull(value, "value"));
+        }
+    }
+}
